# CraftPass environment — copy to .env and adjust.
# Every variable has a production-safe default; only CF_TUNNEL_TOKEN is
# actually required (and only for the cloudflared service in docker-compose).

# --- Cloudflare Tunnel (cloudflared service) -----------------------------
# Zero Trust → Networks → Tunnels → Create tunnel → copy the token
CF_TUNNEL_TOKEN=

# --- CraftPass core --------------------------------------------------------
# Public URL of the auth portal. Must match the Cloudflare public hostname.
ISSUER_URL=https://auth.labcraft.me
# Parent domain of the SSO cookie. The leading dot means "every subdomain".
COOKIE_DOMAIN=.labcraft.me
# Destination after a successful login.
DEFAULT_REDIRECT_URL=https://dash.stream.labcraft.me
# Persistent login lifetime, in days.
SESSION_TTL_DAYS=30

# Optional: while /setup is unclaimed and this is non-empty, the setup wizard
# additionally requires this value. Set it if the tunnel is already live.
SETUP_TOKEN=

# Dev only: set to false when testing over plain http locally.
SECURE_COOKIES=true
